GAMMA_NLI = 0.3
ALPHA_MAX = 0.95
SPECIAL_TOKENS = ["[PAD]", "[UNK]", "[CLS]", "[SEP]", "[MASK]"]


# ===========================================================================
# Tokenizers
# ===========================================================================
class _PairEncoder:
    """Mixin: encode a (text_a, text_b) pair into BERT-style features."""
    cls_token: str = "[CLS]"
    sep_token: str = "[SEP]"

    def encode_pair(
        self,
        text_a: str,
        text_b: Optional[str] = None,
        max_len: int = 64,
    ) -> Dict:
        ta = self.tokenize(text_a)
        tb = self.tokenize(text_b) if text_b is not None else []

        # Reserve room for [CLS], [SEP], and (if pair) extra [SEP]
        budget = max_len - (3 if text_b is not None else 2)
        while len(ta) + len(tb) > budget and (ta or tb):
            (ta if len(ta) >= len(tb) else tb).pop()

        tokens = [self.cls_token] + ta + [self.sep_token]
        span_a = (1, 1 + len(ta))
        span_b = (0, 0)

        if text_b is not None:
            start = len(tokens)
            tokens += tb + [self.sep_token]
            span_b = (start, start + len(tb))

        ids = self.convert_tokens_to_ids(tokens)
        # token_type_ids: 0 for [CLS]+A+[SEP], 1 for B+[SEP]
        n_a = 1 + len(ta) + 1
        token_type_ids = [0] * n_a + [1] * (len(ids) - n_a)

        return {
            "tokens": tokens,
            "input_ids": ids,
            "token_type_ids": token_type_ids,
            "attention_mask": [1] * len(ids),
            "span_a": span_a,
            "span_b": span_b,
        }


class SimpleTokenizer(_PairEncoder):
    """Whitespace/punct tokenizer with a learnable vocab."""
    kind = "simple"
    TOKEN_RE = re.compile(r"\d+(?:[+\-*/]\d+)+|\w+|[^\w\s]", re.UNICODE)

    def __init__(self, vocab: Optional[Dict[str, int]] = None):
        if vocab:
            self.vocab = dict(vocab)
        else:
            self.vocab = {t: i for i, t in enumerate(SPECIAL_TOKENS)}
        self._inv()

    def _inv(self):
        self.inv = {i: t for t, i in self.vocab.items()}

    def tokenize(self, text: str) -> List[str]:
        return self.TOKEN_RE.findall(text.lower())

    def build_vocab(
        self,
        texts: Sequence[str],
        max_size: int = 30000,
        min_freq: int = 1,
    ) -> "SimpleTokenizer":
        c = Counter(tok for t in texts for tok in self.tokenize(t))
        for tok, f in c.most_common():
            if len(self.vocab) >= max_size:
                break
            if f < min_freq:
                break
            if tok not in self.vocab:
                self.vocab[tok] = len(self.vocab)
        self._inv()
        return self

    def convert_tokens_to_ids(self, toks) -> List[int]:
        unk = self.vocab["[UNK]"]
        return [self.vocab.get(t, unk) for t in toks]

    def convert_ids_to_tokens(self, ids) -> List[str]:
        return [self.inv.get(int(i), "[UNK]") for i in ids]

    pad_token_id  = property(lambda s: s.vocab["[PAD]"])
    unk_token_id  = property(lambda s: s.vocab["[UNK]"])
    cls_token_id  = property(lambda s: s.vocab["[CLS]"])
    sep_token_id  = property(lambda s: s.vocab["[SEP]"])
    mask_token_id = property(lambda s: s.vocab["[MASK]"])
    vocab_size    = property(lambda s: len(s.vocab))

    def state(self) -> Dict:
        return {"kind": "simple", "vocab": self.vocab}


class HFTokenizer(_PairEncoder):
    """Thin wrapper around HuggingFace AutoTokenizer."""
    kind = "hf"

    def __init__(self, name: str = "bert-base-uncased"):
        from transformers import AutoTokenizer  # local import to keep module light
        self.name = name
        self.tok = AutoTokenizer.from_pretrained(name)

        # Robustly resolve the CLS/SEP *string* tokens
        self.cls_token = self._resolve_special("cls_token", "cls_token_id")
        self.sep_token = self._resolve_special("sep_token", "sep_token_id")

    def _resolve_special(self, str_attr: str, id_attr: str) -> str:
        # Try the string attribute first
        tok = getattr(self.tok, str_attr, None)
        if isinstance(tok, str) and tok:
            return tok
        # Fall back to id -> token
        sid = getattr(self.tok, id_attr, None)
        if sid is None:
            raise ValueError(f"Tokenizer has neither '{str_attr}' nor '{id_attr}'")
        return self.tok.convert_ids_to_tokens(int(sid))

    def tokenize(self, text: str) -> List[str]:
        return self.tok.tokenize(text)

    def convert_tokens_to_ids(self, toks) -> List[int]:
        return self.tok.convert_tokens_to_ids(list(toks))

    def convert_ids_to_tokens(self, ids) -> List[str]:
        return self.tok.convert_ids_to_tokens([int(i) for i in ids])

    pad_token_id  = property(lambda s: s.tok.pad_token_id)
    unk_token_id  = property(lambda s: s.tok.unk_token_id)
    cls_token_id  = property(lambda s: s.tok.cls_token_id)
    sep_token_id  = property(lambda s: s.tok.sep_token_id)
    mask_token_id = property(lambda s: s.tok.mask_token_id)
    vocab_size    = property(lambda s: len(s.tok))

    def state(self) -> Dict:
        return {"kind": "hf", "name": self.name}


def get_tokenizer(
    name: Optional[str] = "bert-base-uncased",
    texts: Optional[Sequence[str]] = None,
    allow_fallback: bool = True,
):
    """Return a HuggingFace tokenizer if possible, else a SimpleTokenizer."""
    if name and name != "simple":
        try:
            return HFTokenizer(name)
        except Exception as e:
            if not allow_fallback:
                raise
            print(f"[data] HF tokenizer '{name}' unavailable ({type(e).__name__}); "
                  f"using SimpleTokenizer")
    corpus = list(texts or []) + mock_corpus()
    return SimpleTokenizer().build_vocab(corpus)


def tokenizer_from_state(state: Dict):
    return HFTokenizer(state["name"]) if state["kind"] == "hf" else SimpleTokenizer(state["vocab"])


